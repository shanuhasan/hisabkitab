# ==============================================================================
# HisabKitab SaaS — Production Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env on your production server: cp .env.production.example .env
# 2. Generate a secure 32-character APP_KEY: php artisan key:generate
# 3. Fill in your production MySQL credentials, domain URL, and Razorpay LIVE keys.
# 4. NEVER commit your actual .env file to Git!
# ==============================================================================

# Application General Settings
APP_NAME="HisabKitab"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://hisabkitab.in
FORCE_HTTPS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_TIMEZONE=Asia/Kolkata

# Password Hashing
BCRYPT_ROUNDS=12

# Logging Configuration
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Production Database (MySQL 8.0+)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hisabkitab_production
DB_USERNAME=hisabkitab_user
DB_PASSWORD="SECURE_PRODUCTION_DB_PASSWORD"

# Session Management
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=hisabkitab.in
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache & Storage
CACHE_STORE=database
CACHE_PREFIX=hisabkitab_cache_
FILESYSTEM_DISK=local

# Queue Configuration
QUEUE_CONNECTION=database

# Mail Configuration (SMTP / Postmark / SendGrid / SES)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD="YOUR_SMTP_API_KEY"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="support@hisabkitab.in"
MAIL_FROM_NAME="HisabKitab Support"

# Razorpay LIVE Gateway Credentials
# Retrieve from: https://dashboard.razorpay.com/#/app/keys (Live Mode)
RAZORPAY_KEY_ID=rzp_live_YOUR_PRODUCTION_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_PRODUCTION_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_PRODUCTION_WEBHOOK_SECRET

# Vite Build Output
VITE_APP_NAME="${APP_NAME}"

